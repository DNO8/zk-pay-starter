#!/usr/bin/env bash
# Installed by `./scripts/protect-solutions.sh`.
# Blocks pushing the solutions branch to any remote named github / origin
# that looks like GitHub.
set -euo pipefail
remote="${1:-}"
url="${2:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "$remote_ref" == refs/heads/solutions || "$local_ref" == refs/heads/solutions ]]; then
    echo "Refusing to push 'solutions' to ${remote} (${url})."
    echo "That branch stays on this machine. Push main only."
    exit 1
  fi
done

exit 0
